{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "typingmasterproonline-social-api",
  "main": "cloudflare-social-api/worker.js",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://typingmasterproonline.com"
  }
}
